<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\GameReferences.props" />

  <PropertyGroup>
    <AssemblyName>InvectorModKit.CustomSongs</AssemblyName>
    <RootNamespace>InvectorModKit.CustomSongs</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InvectorModKit\InvectorModKit.csproj" Private="false" />
    <ProjectReference Include="..\InvectorModKit.Charting\InvectorModKit.Charting.csproj" Private="false" />
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' != 'false' And Exists('$(PluginsDir)')">
    <Copy SourceFiles="$(OutDir)InvectorModKit.CustomSongs.dll;$(OutDir)InvectorModKit.CustomSongs.pdb" DestinationFolder="$(PluginsDir)\InvectorModKit.CustomSongs" SkipUnchangedFiles="true" />
  </Target>
</Project>
