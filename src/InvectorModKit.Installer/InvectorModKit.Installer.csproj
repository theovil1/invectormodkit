<Project Sdk="Microsoft.NET.Sdk">
  <!-- Installs, updates and uninstalls the mod in a game folder: the logic behind InvectorModKitSetup.exe, without
       any window, so it can be tested on fake game folders. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>InvectorModKit.Installer</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\InvectorModKit.ChartEditor.Core\GameLocator.cs" Link="GameLocator.cs" />
  </ItemGroup>
</Project>
