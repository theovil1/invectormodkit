<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\GameReferences.props" />

  <PropertyGroup>
    <AssemblyName>InvectorModKit.Marketplace</AssemblyName>
    <RootNamespace>InvectorModKit.Marketplace</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InvectorModKit\InvectorModKit.csproj" Private="false" />
    <ProjectReference Include="..\InvectorModKit.Charting\InvectorModKit.Charting.csproj" Private="false" />
    <ProjectReference Include="..\InvectorModKit.CustomSongs\InvectorModKit.CustomSongs.csproj" Private="false" />
    <ProjectReference Include="..\InvectorModKit.Marketplace.Client\InvectorModKit.Marketplace.Client.csproj" />
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' != 'false' And Exists('$(PluginsDir)')">
    <Copy SourceFiles="$(OutDir)InvectorModKit.Marketplace.dll;$(OutDir)InvectorModKit.Marketplace.pdb;$(OutDir)InvectorModKit.Marketplace.Client.dll" DestinationFolder="$(PluginsDir)\InvectorModKit.Marketplace" SkipUnchangedFiles="true" />
  </Target>
</Project>
