<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure C# (no Unity): chart model, JSON format, audio analysis and the automatic chart generator.
       Runs both inside the game (Mono) and in ChartLab/tests (.NET 8). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>InvectorModKit.Charting</RootNamespace>
    <!-- NU1903: Newtonsoft 12 advisory (deeply nested JSON). In game the copy shipped with the game is used anyway;
         the offline tools reference 13.x. Chart files are local files the player chose to install. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 12.0.x matches the Newtonsoft.Json 12.0.0.0 shipped with the game, which the plugin binds to at runtime. -->
    <PackageReference Include="Newtonsoft.Json" Version="12.0.3" />
    <PackageReference Include="NLayer" Version="1.16.0" />
    <PackageReference Include="NVorbis" Version="0.8.6" />
  </ItemGroup>
</Project>
